# Copy to .env and fill in values. .env is gitignored; never commit secrets.
# Variables are read by the apps (CLI, server, eval), never by the core (ADR-003).

# --- LLM translation mode (P1) ---
# Internal OpenAI-compatible LLM server. The URL and key are provided by the server's owners.
DOCTRANSLATOR_LLM_BASE_URL=
DOCTRANSLATOR_LLM_API_KEY=
DOCTRANSLATOR_LLM_MODEL=gemma-4-31b-it

# --- Local document translation (P2/P3) ---
# Default mode for `doctranslator translate` when --mode is not given: mt or llm.
DOCTRANSLATOR_MODE=mt
# Converted SMALL-100 model directory for MT mode.
DOCTRANSLATOR_MT_MODEL_DIR=data/models/alirezamsh--small100-ct2-int8
# Declared revision of the LLM model served as DOCTRANSLATOR_LLM_MODEL (part of the cache identity).
DOCTRANSLATOR_LLM_DEPLOYMENT_REVISION=
# Font directories for fit measurement (OS path separator). Empty: platform font directories.
DOCTRANSLATOR_FONT_DIRS=

# --- Hugging Face (P1) ---
# Token for downloading the gated FLORES+ benchmark dataset. The account must have accepted the
# dataset's terms, and a fine-grained token needs "Read access to contents of all public gated
# repos you can access".
HF_TOKEN=

# --- Local data ---
# Benchmark datasets, job storage, and run outputs. Relative paths resolve from the repository root.
DOCTRANSLATOR_DATA_DIR=data
