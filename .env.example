# Copy to .env and fill in values. .env is gitignored; never commit secrets.
# Variables are read by the apps (CLI, server, eval), never by the core (ADR-003).

# --- LLM translation mode (P1) ---
# Internal OpenAI-compatible LLM server. The URL and key are provided by the server's owners.
DOCTRANSLATOR_LLM_BASE_URL=
DOCTRANSLATOR_LLM_API_KEY=
DOCTRANSLATOR_LLM_MODEL=gemma-4-31b-it

# Optional translation-specialized models, shared by the CLI and evaluation app.
# Keep generic for the existing server. Opt in with translategemma or hy-mt2 only
# after starting a compatible self-hosted server and selecting its served model name.
# Local example: BASE_URL=http://127.0.0.1:8000/v1, API_KEY=local-placeholder
# (a placeholder is suitable only when your loopback server requires no real key).
# TRANSLATION_PROFILE selects the prompt contract; MODEL selects the actual server model.
# Specialized profiles send one segment per request and do not request JSON output.
DOCTRANSLATOR_LLM_TRANSLATION_PROFILE=generic
# Set llamacpp explicitly for llama-server; openai is the default server contract.
# This selects the serving software's decoding parameter names, not the model family.
DOCTRANSLATOR_LLM_SERVER_BACKEND=openai
# Required for specialized profiles: record the exact weights/tokenizer/template revision
# and quantization/build identity of the deployment; update it whenever these change.
DOCTRANSLATOR_LLM_DEPLOYMENT_REVISION=
DOCTRANSLATOR_LLM_MAX_CONCURRENCY=4
DOCTRANSLATOR_LLM_TEMPERATURE=0
DOCTRANSLATOR_LLM_MAX_OUTPUT_TOKENS=2048
DOCTRANSLATOR_LLM_TOP_P=1
DOCTRANSLATOR_LLM_TOP_K=0
DOCTRANSLATOR_LLM_REPETITION_PENALTY=1
DOCTRANSLATOR_LLM_SEED=0

# --- Hugging Face (P1) ---
# Token for downloading the gated FLORES+ benchmark dataset. The account must have accepted the
# dataset's terms, and a fine-grained token needs "Read access to contents of all public gated
# repos you can access".
HF_TOKEN=

# --- Local data ---
# Benchmark datasets, job storage, and run outputs. Relative paths resolve from the repository root.
DOCTRANSLATOR_DATA_DIR=data
