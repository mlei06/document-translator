# Copy to .env and fill in values. .env is gitignored; never commit secrets.
# Variables are read by the apps (CLI, server, eval), never by the core (ADR-003).

# --- LLM translation mode (P1) ---
# Internal OpenAI-compatible LLM server. The URL and key are provided by the server's owners.
DOCTRANSLATOR_LLM_BASE_URL=
DOCTRANSLATOR_LLM_API_KEY=
DOCTRANSLATOR_LLM_MODEL=gemma-4-31b-it

# --- Local document translation (P2/P3) ---
# Default mode for `doctranslator translate` when --mode is not given: mt or llm.
DOCTRANSLATOR_MODE=mt
# Converted SMALL-100 model directory for MT mode.
DOCTRANSLATOR_MT_MODEL_DIR=data/models/alirezamsh--small100-ct2-int8
# Declared revision of the LLM model served as DOCTRANSLATOR_LLM_MODEL (part of the cache identity).
DOCTRANSLATOR_LLM_DEPLOYMENT_REVISION=
# HY-MT uses plain-text translation prompts through an explicitly managed llama.cpp server.
# Set protocol=hy-mt and a nonempty weights/runtime revision; server location requires loopback.
DOCTRANSLATOR_LLM_PROTOCOL=json-batch
DOCTRANSLATOR_LLM_EXECUTION_LOCATION=remote
DOCTRANSLATOR_LLM_MAX_OUTPUT_TOKENS=2048
DOCTRANSLATOR_LLM_MAX_CONCURRENCY=4
# Font directories for fit measurement (OS path separator). Empty: platform font directories.
DOCTRANSLATOR_FONT_DIRS=

# --- Hugging Face (P1) ---
# Token for downloading the gated FLORES+ benchmark dataset. The account must have accepted the
# dataset's terms, and a fine-grained token needs "Read access to contents of all public gated
# repos you can access".
HF_TOKEN=

# --- Local data ---
# Benchmark datasets, job storage, and run outputs. Relative paths resolve from the repository root.
DOCTRANSLATOR_DATA_DIR=data

# --- Shared service (P5) ---
# Server: data directory (database, blobs), bind address and TLS for non-loopback binds.
DOCTRANSLATOR_DATA_DIR=data/server
DOCTRANSLATOR_SERVER_HOST=127.0.0.1
DOCTRANSLATOR_SERVER_PORT=8765
DOCTRANSLATOR_SERVER_TLS_CERT=
DOCTRANSLATOR_SERVER_TLS_KEY=
DOCTRANSLATOR_WORKERS=1
# Service CLI: where the service is. The API key goes in DOCTRANSLATOR_API_KEY (never commit it)
# or in the OS credential store (service "doctranslator", name DOCTRANSLATOR_API_KEY).
DOCTRANSLATOR_SERVER_URL=http://127.0.0.1:8765
DOCTRANSLATOR_API_KEY=

# --- Configured service translators (ADR-019) ---
# Optional JSON list. When supplied, it replaces the legacy MT/LLM service engine settings above.
# Only the server/admin reads these settings; capabilities never expose paths, URLs or keys.
# A nonempty enabled list requires an explicit default ID. Restart API/workers after changes.
# DOCTRANSLATOR_TRANSLATORS='[{"id":"small100","label":"SMALL-100","enabled":true,"engine":{"mode":"mt","model_dir":"data/models/alirezamsh--small100-ct2-int8","model_family":"small100","device":"auto","compute_type":"int8"}}]'
# DOCTRANSLATOR_DEFAULT_TRANSLATOR_ID=small100
# Retained loaded local runtimes per worker, not the number of installed/available models.
DOCTRANSLATOR_MAX_LOADED_LOCAL_MODELS=1

# Davy discovery: expose only approved models listed by authenticated GET /models.
# Do not duplicate these entries as generic LLM translators above.
# DOCTRANSLATOR_DAVY_BASE_URL=https://your-approved-host/v1
# DOCTRANSLATOR_DAVY_API_KEY=replace-with-secret
# DOCTRANSLATOR_DAVY_MODELS='[{"id":"gemma","label":"Gemma","model":"gemma-4-31b-it","enabled":true}]'

# Explicitly enable basic browser account creation for an internal/local deployment.
DOCTRANSLATOR_REGISTRATION_ENABLED=false

# Unified automatic website policy. Configure all approved Davy identities plus local HY-MT.
DOCTRANSLATOR_WEB_TRANSLATION_POLICY={"revision":"web-auto-v2","davy_order":["gemma","nemotron-3-ultra","nemotron-3-super-120b","gpt-oss-120b-thinking","gpt-oss-120b","laguna-s-2.1"],"local_translator_id":"hy-mt-local"}
DOCTRANSLATOR_GLOBAL_BLOB_BUDGET_BYTES=107374182400
DOCTRANSLATOR_GLOBAL_WORK_BUDGET_BYTES=8589934592
DOCTRANSLATOR_BACKUP_BUDGET_BYTES=107374182400
DOCTRANSLATOR_DAILY_BACKUPS=true
